diff --git a/src/urg_c_wrapper.cpp b/src/urg_c_wrapper.cpp
index 016a727..b94140c 100644
--- a/src/urg_c_wrapper.cpp
+++ b/src/urg_c_wrapper.cpp
@@ -69,6 +69,10 @@ URGCWrapper::URGCWrapper(
     ss << "Could not open network Hokuyo:\n";
     ss << ip_address_ << ":" << ip_port_ << "\n";
     ss << urg_error(&urg_);
+    // urg_open() can open TCP before a later SCIP initialization failure.
+    // A throwing constructor has no destructor, so explicitly release the
+    // scanner's single TCP session before the node retries.
+    urg_close(&urg_);
     throw std::runtime_error(ss.str());
   }
 
